# Normalise line endings so the repo behaves the same on Windows, Linux and macOS
* text=auto eol=lf

# Windows scripts need CRLF; shell scripts must stay LF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# binaries
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.db binary
